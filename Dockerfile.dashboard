# Same Python as the other images and as the laptop venv that trains the model
# (the lab text uses 3.11; a pickle is safest loaded by the same Python + scikit-learn).
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements-dashboard.txt .
RUN pip install --no-cache-dir -r requirements-dashboard.txt
# With several source files the destination must be a directory ending in "/"
COPY db.py quality.py predict.py dashboard.py model.pkl model_meta.json ./
EXPOSE 8000
# --no-access-log: the app writes its own structured JSON line per request instead of plain-text access logs
CMD ["uvicorn", "dashboard:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]

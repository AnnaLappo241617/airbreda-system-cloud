# Copy to .env and fill in. Never commit .env.
# --- Database (air-ingest) ---
DB_HOST=your-db.xxxxxxxx.eu-north-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-password
# --- S3 (traffic-ingest). Containers can't see your `aws configure`, so give keys here ---
S3_BUCKET=airbreda-yourname-2026
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_DEFAULT_REGION=eu-north-1
UPLOAD_RAW=1
# --- Redis (Day 2). "redis" works inside docker compose; use localhost when running scripts on your laptop
REDIS_HOST=redis
# --- Polling ---
POLL_INTERVAL_SECONDS=3600
